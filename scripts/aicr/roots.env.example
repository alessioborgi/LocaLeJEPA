# Site roots for the AICR launcher. Copy to scripts/aicr/roots.env (git-ignored) on the cluster
# and fill every value in. The launcher sources roots.env and REFUSES to run on any value that
# still says CHANGE_ME -- a placeholder that fails loudly, never a default that charges someone
# else's account or writes into the checkout (research_rules/07).
#
# Nothing here is read from the submitting shell: jobs are submitted with --export=NONE plus the
# few per-submission variables (GRID, REPO, REQUEUE_LEFT, TIME_LIMIT), so a job's behaviour
# cannot depend on which modules or conda env the shell happened to have (research_rules/01).
export PY=CHANGE_ME            # absolute path to the campaign env's python, e.g. $HOME/conda/envs/localejepa-aicr/bin/python
export CKPT_ROOT=CHANGE_ME     # where checkpoints/<run_name>/ go: /work for the IN1K and torus rows. An ablation wave
                               # passes --export CKPT_ROOT_OVERRIDE=<scratch dir> at submission instead; never edit this
                               # file between submissions -- jobs read it when they start, not when they are submitted
export LOG_ROOT=CHANGE_ME      # hydra run dirs and Slurm logs; on /scratch
export DATA_ROOT=CHANGE_ME     # Imagenette is expected at $DATA_ROOT/imagenette
export DATA_TAR=CHANGE_ME      # the ImageNet-1K tar, extracted to node-local /tmp per job; unset ("") for Imagenette-only waves
export ENV_LOCK=CHANGE_ME      # the frozen `pip freeze` the environment must hash to (F38)
